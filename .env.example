# LLM via LiteLLM + langchain-openai (leave API key empty => mock/rule fallback)
# LiteLLM model id examples: gpt-4o-mini | openai/gpt-4o-mini | deepseek/deepseek-chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# LangSmith / Studio (optional; free Developer plan is enough to open Studio)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Optional API protection
GRIDMIND_API_KEY=

# Optional infra (unused in default degrade mode)
DATABASE_URL=
REDIS_URL=

