# LLM via LiteLLM + langchain-openai (leave API key empty => mock/rule fallback)
# LiteLLM model id examples: gpt-4o-mini | openai/gpt-4o-mini | deepseek/deepseek-chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# LangSmith / Studio (optional; free Developer plan is enough to open Studio)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Optional API protection
GRIDMIND_API_KEY=

# Postgres + pgvector（留空则 RAG 走内存；填了则用真实库）
# 示例（本机 Docker pgvector）:
# DATABASE_URL=postgresql://postgres:icosmos@127.0.0.1:5432/gridmind
# 或 docker compose（docker/docker-compose.yml）:
# DATABASE_URL=postgresql://gridmind:gridmind@127.0.0.1:5432/gridmind
DATABASE_URL=
EMBEDDING_DIM=64
REDIS_URL=

# Docling Serve（Docker 独立部署，默认 CPU 镜像端口 5001）
# docker compose -f docker/docker-compose.yml up -d docling
DOCLING_SERVE_URL=http://127.0.0.1:5001
DOCLING_SERVE_API_KEY=
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5

# Wren Core 语义规划（pip: wren-core-py）。true=优先 transform_sql，失败回退本地 compiler
WREN_CORE_ENABLED=true

